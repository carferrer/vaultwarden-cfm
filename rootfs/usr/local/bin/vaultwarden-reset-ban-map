#!/bin/bash
set -euo pipefail

# The map is a disposable projection of Fail2ban's persistent SQLite database.
# Reset before Nginx starts and before every Fail2ban start, including recovery
# from SIGKILL. The packaged nginx-block-map action appends restored bans.
mkdir -p /data/fail2ban
install -m 600 /dev/null /data/fail2ban/banned.map
if [[ "${1:-}" == "--reload" ]]; then
    nginx -t
    nginx -s reload
fi
