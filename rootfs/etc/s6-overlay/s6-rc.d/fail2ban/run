#!/command/with-contenv bashio
# Fail2ban no necesita permisos para modificar el cortafuegos del anfitrión.
# La acción nginx-block-map actualiza la lista de bloqueo y recarga el Nginx local.
if ! bashio::config.true 'fail2ban_enabled'; then
    bashio::log.info 'Fail2ban está desactivado en la configuración del complemento.'
    exec sleep infinity
fi

maxretry="$(bashio::config 'fail2ban_maxretry')"
findtime="$(bashio::config 'fail2ban_findtime')"
bantime="$(bashio::config 'fail2ban_bantime')"

# Limitar los parámetros y rechazar valores incorrectos o peligrosos.
for value in "$maxretry" "$findtime" "$bantime"; do
    [[ "$value" =~ ^[0-9]+$ ]] || bashio::exit.nok 'Los valores de Fail2ban deben ser números enteros positivos'
done
(( maxretry >= 2 && maxretry <= 100 )) || bashio::exit.nok 'fail2ban_maxretry debe estar entre 2 y 100'
(( findtime >= 60 && findtime <= 86400 )) || bashio::exit.nok 'fail2ban_findtime debe estar entre 60 y 86400'
(( bantime >= 60 && bantime <= 604800 )) || bashio::exit.nok 'fail2ban_bantime debe estar entre 60 y 604800'

mkdir -p /run/fail2ban /data/fail2ban /etc/fail2ban/jail.d
touch /data/fail2ban/vaultwarden.log /data/fail2ban/banned.map
chmod 600 /data/fail2ban/banned.map /data/fail2ban/vaultwarden.log

cat > /etc/fail2ban/jail.d/vaultwarden-cfm.local <<EOF
[DEFAULT]
backend = polling
usedns = no
dbfile = /data/fail2ban/fail2ban.sqlite3
bantime = $bantime
findtime = $findtime
maxretry = $maxretry

[vaultwarden-cfm]
enabled = true
filter = vaultwarden-cfm
logpath = /data/fail2ban/vaultwarden.log
action = nginx-block-map[blck_lst_file=/data/fail2ban/banned.map]
EOF

# La acción de recarga necesita que Nginx esté en ejecución y su configuración sea válida.
bashio::net.wait_for 7277
bashio::log.info 'Iniciando Fail2ban para detectar accesos fallidos a Vaultwarden...'
exec fail2ban-server -f -x start
