#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Complemento de Home Assistant: Vaultwarden
# Inicia el servidor Vaultwarden
# ==============================================================================
declare admin_token
declare log_level
declare request_size_limit
declare secret_key

# Establecer valores predeterminados
export DATA_FOLDER=/data
export ROCKET_PORT=80
export ROCKET_WORKERS=2

# Generar una clave aleatoria para evitar avisos innecesarios en los registros.
secret_key=$(openssl rand -base64 32)
export ROCKET_SECRET_KEY="${secret_key}"

# Determinar el nivel de registro correspondiente
if bashio::config.has_value 'log_level'; then
    case "$(bashio::string.lower "$(bashio::config 'log_level')")" in
        all|trace)
            log_level="trace"
            ;;
        debug)
            log_level="debug"
            ;;
        info|notice)
            log_level="info"
            ;;
        warning)
            log_level="warn"
            ;;
        error|fatal)
            log_level="error"
            ;;
        off)
            log_level="off"
            ;;
    esac

    export LOG_LEVEL="${log_level}"
fi

# Fail2ban necesita un registro persistente específico de autenticación de Vaultwarden.
if bashio::config.true 'fail2ban_enabled'; then
    mkdir -p /data/fail2ban
    touch /data/fail2ban/vaultwarden.log
    chmod 600 /data/fail2ban/vaultwarden.log
    export EXTENDED_LOGGING=true
    export LOG_FILE=/data/fail2ban/vaultwarden.log
    # No se deben desactivar los mensajes de error cuando está habilitado Fail2ban.
    if [[ "${LOG_LEVEL:-}" == "off" ]]; then
        bashio::log.warning 'Se cambia LOG_LEVEL=off a error para permitir el funcionamiento de Fail2ban.'
        export LOG_LEVEL=error
    fi
fi

# Mostrar el token de administración en el registro cuando aún no existe configuración.
if ! bashio::fs.file_exists '/data/config.json'; then
    admin_token=$(openssl rand -base64 48)
    export ADMIN_TOKEN="${admin_token}"

    bashio::log.info
    bashio::log.info
    bashio::log.info "¡LEE ESTO ATENTAMENTE! ¡LEE ESTO ATENTAMENTE!"
    bashio::log.info
    bashio::log.info
    bashio::log.info "Este es tu token o contraseña temporal de administración, generado aleatoriamente."
    bashio::log.info
    bashio::log.info "${admin_token}"
    bashio::log.info
    bashio::log.info "Cámbialo en el panel de administración lo antes posible."
    bashio::log.info
    bashio::log.info "Una vez que hayas modificado cualquier ajuste en el panel de administración,"
    bashio::log.info "el complemento dejará de generar un token nuevo en cada arranque"
    bashio::log.info "y dejará de mostrar este mensaje."
    bashio::log.info
fi

# Límite de tamaño de las peticiones a la API
if bashio::config.has_value 'request_size_limit'; then
    request_size_limit=$(bashio::config 'request_size_limit')
    export ROCKET_LIMITS="{json=${request_size_limit}}"
fi

# Iniciar el servidor Vaultwarden
bashio::log.info 'Iniciando el servidor Vaultwarden...'
cd /opt || bashio::exit.nok
exec ./vaultwarden
